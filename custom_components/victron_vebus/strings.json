        "title": "Enter device",
        "data": {
          "device": "Device"
        },
        "data_description": {
          "device": "Device path such as /dev/serial/by-id/usb-VictronEnergy_MK3-USB_Interface_..., or a URL such as socket://192.168.1.10:4001 for ser2net."
        }
      },
      "usb_confirm": {
        "description": "Do you want to set up the Victron VE.Bus device connected to the MK3 interface at {device}?"
